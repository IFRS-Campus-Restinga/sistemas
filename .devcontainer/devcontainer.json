{
  "name": "Hub Sistemas IFRS",
  "dockerComposeFile": "docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/workspace",
  "runServices": ["backend", "frontend"],
  "shutdownAction": "stopCompose",
  "initializeCommand": "docker network inspect ifrs-dev-network >NUL 2>&1 || docker network create ifrs-dev-network",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Frontend - Hub Sistemas",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Backend - Hub Sistemas",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
