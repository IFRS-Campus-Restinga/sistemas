# Django Settings
ENVIRONMENT=dev
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# CORS/Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
REDIRECT_URI=http://localhost:8000/django-admin/google/callback/

# Application URLs
BASE_SYSTEM_URL=http://localhost:8000
CAMPUS_CODE=IFR

# FS Auth Middleware
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_HTTPONLY=True
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_REFRESH_MAX_AGE=604800
AUTH_COOKIE_REFRESH_PATH=/
AUTH_COOKIE_ACCESS_PATH=/

# Database (PostgreSQL — obrigatório apenas quando ENVIRONMENT=prod)
POSTGRES_DB=hub_sistemas_ifrs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Superusuário inicial (criado automaticamente pelo entrypoint.py na primeira execução)
ROOT_USER=

# Timezone
TZ=America/Sao_Paulo
